{
    "description": "Moonlight Windows Layout: Caps to F16 Fix",
    "manipulators": [
        {
            "conditions": [
                {
                    "file_paths": ["^/Applications/Moonlight\\.app/Contents/MacOS/Moonlight$"],
                    "type": "frontmost_application_if"
                }
            ],
            "description": "Left Command to Left Alt",
            "from": {
                "key_code": "left_command",
                "modifiers": { "optional": ["any"] }
            },
            "to": [{ "key_code": "left_alt" }],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "file_paths": ["^/Applications/Moonlight\\.app/Contents/MacOS/Moonlight$"],
                    "type": "frontmost_application_if"
                }
            ],
            "description": "Left Option to Left Command (Win)",
            "from": {
                "key_code": "left_option",
                "modifiers": { "optional": ["any"] }
            },
            "to": [{ "key_code": "left_command" }],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "file_paths": ["^/Applications/Moonlight\\.app/Contents/MacOS/Moonlight$"],
                    "type": "frontmost_application_if"
                }
            ],
            "description": "Right Command to Right Option",
            "from": {
                "key_code": "right_command",
                "modifiers": { "optional": ["any"] }
            },
            "to": [{ "key_code": "right_option" }],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "file_paths": ["^/Applications/Moonlight\\.app/Contents/MacOS/Moonlight$"],
                    "type": "frontmost_application_if"
                }
            ],
            "description": "Right Option to CapsLock",
            "from": {
                "key_code": "right_option",
                "modifiers": { "optional": ["any"] }
            },
            "to": [{ "key_code": "caps_lock" }],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "file_paths": ["^/Applications/Moonlight\\.app/Contents/MacOS/Moonlight$"],
                    "type": "frontmost_application_if"
                }
            ],
            "description": "Physical CapsLock to F16 (Kor/Eng Toggle Signal)",
            "from": {
                "key_code": "caps_lock",
                "modifiers": { "optional": ["any"] }
            },
            "to": [{ "key_code": "f16" }],
            "type": "basic"
        }
    ]
}
